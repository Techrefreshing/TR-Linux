set -eu

# live-config may regenerate /etc/os-release while preparing the live account.
# Reapply the public distribution identity before the display manager starts.
cat > /usr/lib/os-release <<'OSRELEASE'
PRETTY_NAME="TechRefreshing Linux 1.0"
NAME="TechRefreshing Linux"
VERSION_ID="1.0"
VERSION="1.0 (Trixie)"
VERSION_CODENAME=trixie
ID=trlinux
ID_LIKE=debian
HOME_URL="https://techrefreshing.com/"
SUPPORT_URL="https://techrefreshing.com/linux/"
BUG_REPORT_URL="https://github.com/Techrefreshing/TR-Linux/issues"
LOGO=tr-linux
ANSI_COLOR="0;105;180"
OSRELEASE

rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release
cat > /etc/lsb-release <<'LSBRELEASE'
DISTRIB_ID=TechRefreshing
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=trixie
DISTRIB_DESCRIPTION="TechRefreshing Linux 1.0"
LSBRELEASE

# KInfoCenter supports a distributor override here. Debian's packaged file
# otherwise supplies its major version and logo independently of os-release.
install -d /etc/xdg
cat > /etc/xdg/kcm-about-distrorc <<'KINFOCENTER'
[General]
LogoPath=/usr/share/tr-linux/branding/tr-monogram.png
Website=https://techrefreshing.com/
Version=1.0
UseOSReleaseVersion=false
KINFOCENTER

printf '%s\n' 'TechRefreshing Linux 1.0 \n \l' > /etc/issue
printf '%s\n' 'TechRefreshing Linux 1.0' > /etc/issue.net
