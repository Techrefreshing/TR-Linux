class SystemPage(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(30, 24, 30, 24)
        layout.setSpacing(12)
        layout.addLayout(heading("Update and maintain", "APT, Flatpak and firmware tools"))
        layout.addWidget(section(
            "System updates",
            "Refresh package information and install available Debian/TR Linux updates in a terminal.",
            [command_button(
                "Check for updates", "sudo apt update; apt list --upgradable; exec bash",
                "This refreshes APT package information. It does not install packages."
            ), command_button(
                "Install updates", "sudo apt update && sudo apt full-upgrade; exec bash",
                "This can install, upgrade, or remove packages to bring the system fully up to date."
            )]
        ))
        layout.addWidget(section(
            "Flatpak and firmware",
            "Update sandboxed applications or check supported device firmware.",
            [command_button("Update Flatpaks", "flatpak update; exec bash"),
             launch("Firmware updates", "plasma-discover", ["--mode", "Update"])]
        ))
        layout.addWidget(section(
            "Maintenance",
            "Review disk use or clean downloaded APT package files.",
            [launch("Disk usage", "filelight"), command_button(
                "Clean APT cache", "sudo apt clean; echo 'APT cache cleaned.'; exec bash",
                "This deletes downloaded APT package files. Installed software is not removed."
            )]
        ))
        layout.addStretch()


