import argparse
import html
import os
import subprocess
import sys

from PyQt6.QtCore import Qt, QUrl
from PyQt6.QtGui import QDesktopServices, QIcon, QPixmap
from PyQt6.QtWidgets import (
    QApplication, QCheckBox, QFrame, QGridLayout, QHBoxLayout, QLabel,
    QListWidget, QListWidgetItem, QMainWindow, QMessageBox, QPushButton,
    QStackedWidget, QTextBrowser, QVBoxLayout, QWidget
)

DOC_ROOT = "/usr/share/doc/tr-linux"
LOGO = "/usr/share/tr-linux/branding/tr-monogram.png"
BLUE = "#42A5F5"
NAVY = "#071226"
PANEL = "#0E1B2B"
TEXT = "#F5F7FA"
MUTED = "#AFC5DD"
WELCOME_MARKER = os.path.expanduser("~/.config/tr-linux-welcome-seen")
AUTOSTART_MARKER = os.path.expanduser("~/.config/tr-linux-welcome-autostart")


def open_url(url):
    QDesktopServices.openUrl(QUrl(url))


def button(label, url):
    control = QPushButton(label)
    control.setCursor(Qt.CursorShape.PointingHandCursor)
    control.clicked.connect(lambda: open_url(url))
    return control


def launch(label, program, arguments=None, explanation=None):
    """Create a button for one audited, predefined local command."""
    control = QPushButton(label)
    control.setCursor(Qt.CursorShape.PointingHandCursor)

    def run():
        if explanation:
            answer = QMessageBox.question(
                control, label, explanation + "\n\nContinue?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if answer != QMessageBox.StandardButton.Yes:
                return
        try:
            subprocess.Popen([program] + (arguments or []), start_new_session=True)
        except OSError as error:
            QMessageBox.critical(control, label, f"Unable to start {program}: {error}")

    control.clicked.connect(run)
    return control


def command_button(label, command, explanation=None):
    return launch(label, "konsole", ["-e", "bash", "-lc", command], explanation)


def section(title, subtitle, actions):
    card = QFrame()
    card.setObjectName("ActionCard")
    layout = QVBoxLayout(card)
    name = QLabel(title)
    name.setObjectName("CardTitle")
    layout.addWidget(name)
    detail = QLabel(subtitle)
    detail.setObjectName("CardText")
    detail.setWordWrap(True)
    layout.addWidget(detail)
    row = QHBoxLayout()
    for action in actions:
        row.addWidget(action)
    row.addStretch()
    layout.addLayout(row)
    return card


def heading(title, subtitle=""):
    box = QVBoxLayout()
    title_label = QLabel(title)
    title_label.setObjectName("PageTitle")
    box.addWidget(title_label)
    if subtitle:
        sub = QLabel(subtitle)
        sub.setObjectName("Subtitle")
        sub.setWordWrap(True)
        box.addWidget(sub)
    return box


class WelcomePage(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(36, 30, 36, 30)
        layout.setSpacing(18)

        banner = QFrame()
        banner.setObjectName("Banner")
        row = QHBoxLayout(banner)
        logo = QLabel()
        pix = QPixmap(LOGO)
        logo.setPixmap(pix.scaled(128, 128, Qt.AspectRatioMode.KeepAspectRatio,
                                  Qt.TransformationMode.SmoothTransformation))
        row.addWidget(logo)
        words = QVBoxLayout()
        name = QLabel("Tech<span style='color:#42A5F5'>Refreshing</span> Linux")
        name.setObjectName("Hero")
        name.setTextFormat(Qt.TextFormat.RichText)
        words.addWidget(name)
        slogan = QLabel("Familiar. Beautiful. Stable.")
        slogan.setObjectName("Subtitle")
        words.addWidget(slogan)
        row.addLayout(words, 1)
        layout.addWidget(banner)

        layout.addLayout(heading(
            "Welcome to TechRefreshing Linux 1.0",
            "A Debian Stable desktop created for familiar, dependable everyday computing."
