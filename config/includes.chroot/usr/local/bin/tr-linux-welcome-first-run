set -eu

case "${HOME:-}" in
    /home/*) ;;
    *) exit 0 ;;
esac

marker="$HOME/.config/tr-linux-welcome-seen"
autostart="$HOME/.config/tr-linux-welcome-autostart"
[ -e "$marker" ] && [ ! -e "$autostart" ] && exit 0
mkdir -p "$HOME/.config"
touch "$marker"

# Give Plasma time to finish the panel and desktop layout before presenting
# the welcome window.
sleep 6
exec /usr/local/bin/tr-linux-welcome
