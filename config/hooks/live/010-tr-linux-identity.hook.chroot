#!/bin/sh
set -eu

cat > /usr/lib/os-release <<'OSRELEASE'
PRETTY_NAME="TechRefreshing Linux 1.0"
NAME="TechRefreshing Linux"
VERSION_ID="1.0"
VERSION="1.0 (Trixie)"
VERSION_CODENAME=trixie
ID=trlinux
ID_LIKE=debian
HOME_URL="https://techrefreshing.com/"
SUPPORT_URL="https://techrefreshing.com/linux/"
BUG_REPORT_URL="https://github.com/Techrefreshing/TR-Linux/issues"
LOGO=tr-linux
OSRELEASE

ln -sf ../usr/lib/os-release /etc/os-release
printf '%s\n' 'TechRefreshing Linux 1.0 \n \l' > /etc/issue
printf '%s\n' 'TechRefreshing Linux 1.0' > /etc/issue.net
printf '%s\n' 'tr-linux' > /etc/hostname

install -d /usr/share/pixmaps
cp /usr/share/tr-linux/branding/tr-monogram.png /usr/share/pixmaps/tr-linux.png
