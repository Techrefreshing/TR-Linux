#!/bin/sh
# Copyright © 2026 TechRefreshing
# SPDX-License-Identifier: GPL-3.0-only
set -eu

BRAND=/etc/calamares/branding/trlinux
install -d "$BRAND" /etc/calamares/modules
cp /usr/share/tr-linux/branding/tr-monogram.png "$BRAND/tr-monogram.png"
cp /usr/share/tr-linux/branding/calamares-welcome.png "$BRAND/welcome.png"
cp /usr/share/tr-linux/branding/calamares-slide1.png "$BRAND/slide1.png"

cat > "$BRAND/branding.desc" <<'BRANDING'
---
componentName: trlinux
welcomeStyleCalamares: true
welcomeExpandingLogo: false
windowExpanding: normal
# Keep navigation buttons visible between the 30 px top bar and 58 px dock on
# common 1366x768 laptops. Long Summary content remains independently scrollable.
windowSize: 960px,600px
windowPlacement: center

strings:
    productName: TechRefreshing Linux
    shortProductName: TR Linux
    version: 1.0
    shortVersion: 1.0
    versionedName: TechRefreshing Linux 1.0
    shortVersionedName: TR Linux 1.0
    bootloaderEntryName: TR Linux
    productUrl: https://techrefreshing.com/
    supportUrl: https://techrefreshing.com/linux/
    knownIssuesUrl: https://github.com/Techrefreshing/TR-Linux/issues
    releaseNotesUrl: https://github.com/Techrefreshing/TR-Linux

sidebar: widget
navigation: widget

images:
    productLogo: "tr-monogram.png"
    productIcon: "tr-monogram.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"

style:
   SidebarBackground: "#0E1B2B"
   SidebarText: "#FFFFFF"
   SidebarTextCurrent: "#FFFFFF"
   SidebarBackgroundCurrent: "#1565C0"

slideshowAPI: 2
BRANDING

cat > "$BRAND/show.qml" <<'QML'
import QtQuick 2.15

Rectangle {
    width: 800
    height: 450
    color: "#0E1B2B"
    Image {
        anchors.fill: parent
        source: "slide1.png"
        fillMode: Image.PreserveAspectFit
        smooth: true
    }
}
QML

if [ -f /etc/calamares/settings.conf ]; then
    if grep -q '^branding:' /etc/calamares/settings.conf; then
        sed -i 's/^branding:.*/branding: trlinux/' /etc/calamares/settings.conf
    else
        printf '\nbranding: trlinux\n' >> /etc/calamares/settings.conf
    fi

    # Apply branding inside the target after the bootloader module has written
    # its files but before Calamares unmounts the installation.
    if ! grep -q 'shellprocess@tridentity' /etc/calamares/settings.conf; then
        sed -i '/^[[:space:]]*- umount[[:space:]]*$/i\      - shellprocess@tridentity' /etc/calamares/settings.conf
    fi
fi

cat > /etc/calamares/modules/shellprocess-tridentity.conf <<'IDENTITY'
---
dontChroot: false
timeout: 180
verbose: true
script:
  - command: "/usr/local/sbin/tr-linux-finalize-target '${USER}'"
    timeout: 180
i18n:
  name: "Applying TechRefreshing identity"
IDENTITY

cat > /etc/calamares/modules/welcome.conf <<'WELCOME'
---
showSupportUrl: true
showKnownIssuesUrl: true
showReleaseNotesUrl: true
requirements:
  # The installed desktop needs substantially less than this. Keep enough
  # headroom for updates without rejecting common 16 GB test VMs.
  requiredStorage: 12.0
  requiredRam: 2.0
  check:
    - storage
    - ram
WELCOME

# Accept any user-entered password, including simple numeric passwords. The
# weak-password option is visible and enabled by default as a second safeguard
# for Calamares builds compiled with libpwquality support.
cat > /etc/calamares/modules/users.conf <<'USERS'
---
defaultGroups:
  - cdrom
  - floppy
  - sudo
  - audio
  - dip
  - video
  - plugdev
  - netdev
  - lpadmin
  - scanner
  - bluetooth
autologinGroup: autologin
sudoersGroup: sudo
sudoersConfigureWithGroup: false
setRootPassword: false
displayAutologin: true
doAutologin: false

passwordRequirements:
  minLength: -1
  maxLength: -1
  libpwquality:
    - minlen=0
    - minclass=0
allowWeakPasswords: true
allowWeakPasswordsDefault: true

user:
  shell: /bin/bash
  forbidden_names: [ root, nobody ]
  home_permissions: "o700"

hostname:
  location: EtcFile
  writeHostsFile: true
  template: "${first}-tr-linux"
  forbidden_names: [ localhost ]
USERS
