#!/bin/sh
# Copyright © 2026 TechRefreshing
# SPDX-License-Identifier: GPL-3.0-only
set -eu

BRAND=/etc/calamares/branding/trlinux
install -d "$BRAND" /etc/calamares/modules
cp /usr/share/tr-linux/branding/tr-monogram.png "$BRAND/tr-monogram.png"
cp /usr/share/tr-linux/branding/calamares-welcome.png "$BRAND/welcome.png"
cp /usr/share/tr-linux/branding/calamares-slide1.png "$BRAND/slide1.png"

cat > "$BRAND/branding.desc" <<'BRANDING'
---
componentName: trlinux
welcomeStyleCalamares: true
welcomeExpandingLogo: false
windowExpanding: normal
# Keep navigation buttons visible between the 30 px top bar and 58 px dock on
# common 1366x768 laptops. Long Summary content remains independently scrollable.
windowSize: 960px,600px
windowPlacement: center

strings:
    productName: TechRefreshing Linux
    shortProductName: TR Linux
    version: 1.0
    shortVersion: 1.0
    versionedName: TechRefreshing Linux 1.0
    shortVersionedName: TR Linux 1.0
    bootloaderEntryName: TR Linux
    productUrl: https://techrefreshing.com/
    supportUrl: https://techrefreshing.com/linux/
    knownIssuesUrl: https://github.com/Techrefreshing/TR-Linux/issues
    releaseNotesUrl: https://github.com/Techrefreshing/TR-Linux

sidebar: widget
navigation: widget

images:
    productLogo: "tr-monogram.png"
    productIcon: "tr-monogram.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"

style:
   SidebarBackground: "#0E1B2B"
   SidebarText: "#FFFFFF"
   SidebarTextCurrent: "#FFFFFF"
   SidebarBackgroundCurrent: "#1565C0"

slideshowAPI: 2
BRANDING

cat > "$BRAND/show.qml" <<'QML'
import QtQuick 2.15

Rectangle {
    id: root
    width: 800
    height: 450
    color: "#0E1B2B"

    property int slide: 0
    property var titles: [
        "Welcome to TechRefreshing Linux",
        "A familiar desktop, thoughtfully refined",
        "Ready for everyday work",
        "Software your way",
        "Private by default",
        "Help is always close"
    ]
    property var descriptions: [
        "A stable Debian foundation with a polished KDE Plasma desktop, created for beginners and experienced Linux users alike.",
        "Use the top system bar and centred floating dock to reach files, Firefox, Discover and TR Welcome without hunting through menus.",
        "Firefox ESR, LibreOffice, VLC, Thunderbird, GIMP and useful KDE applications are ready when installation finishes.",
        "Install trusted packages with APT or browse graphical applications in Discover. Flatpak and Flathub support are included.",
        "TechRefreshing Linux adds no mandatory telemetry. Privacy controls, legal notices and source-code information are available from TR Welcome.",
        "Open TR Welcome for updates, hardware checks, desktop profiles, recovery tools, documentation and support links."
    ]
    property var labels: [
        "Stable • Familiar • Beautiful",
        "Top bar • Floating dock • Plasma 6",
        "Web • Office • Media • Graphics",
        "APT • Discover • Flatpak",
        "No mandatory TR telemetry",
        "Diagnostics • Recovery • Support"
    ]

    Timer {
        interval: 7500
        running: true
        repeat: true
        onTriggered: root.slide = (root.slide + 1) % root.titles.length
    }

    Rectangle {
        anchors.fill: parent
        gradient: Gradient {
            GradientStop { position: 0.0; color: "#081525" }
            GradientStop { position: 1.0; color: "#123D73" }
        }
    }

    Image {
        id: logo
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        anchors.topMargin: 34
        width: 112
        height: 112
        source: "tr-monogram.png"
        fillMode: Image.PreserveAspectFit
        smooth: true
    }

    Text {
        anchors.top: logo.bottom
        anchors.topMargin: 18
        anchors.horizontalCenter: parent.horizontalCenter
        width: parent.width - 100
        horizontalAlignment: Text.AlignHCenter
        text: root.titles[root.slide]
        color: "#FFFFFF"
        font.pixelSize: 30
        font.bold: true
        wrapMode: Text.WordWrap
    }

    Text {
        anchors.centerIn: parent
        anchors.verticalCenterOffset: 54
        width: parent.width - 150
        horizontalAlignment: Text.AlignHCenter
        text: root.descriptions[root.slide]
        color: "#DCEBFA"
        font.pixelSize: 18
        lineHeight: 1.25
        wrapMode: Text.WordWrap
    }

    Rectangle {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: indicators.top
        anchors.bottomMargin: 22
        width: featureLabel.implicitWidth + 34
        height: 38
        radius: 19
        color: "#17385D"
        border.color: "#42A5F5"
        border.width: 1
        Text {
            id: featureLabel
            anchors.centerIn: parent
            text: root.labels[root.slide]
            color: "#6CC4FF"
            font.pixelSize: 15
            font.bold: true
        }
    }

    Row {
        id: indicators
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 24
        spacing: 10
        Repeater {
            model: root.titles.length
            Rectangle {
                width: index === root.slide ? 24 : 9
                height: 9
                radius: 5
                color: index === root.slide ? "#42A5F5" : "#45627F"
                Behavior on width { NumberAnimation { duration: 180 } }
            }
        }
    }
}
QML

if [ -f /etc/calamares/settings.conf ]; then
    if grep -q '^branding:' /etc/calamares/settings.conf; then
        sed -i 's/^branding:.*/branding: trlinux/' /etc/calamares/settings.conf
    else
        printf '\nbranding: trlinux\n' >> /etc/calamares/settings.conf
    fi

fi

# Installed-system identity is finalized by tr-linux-first-boot.service. Do not
# add a custom Calamares sequence item: Debian's packaged sequence includes
# custom modules such as sources-final and its module ordering must stay intact.
rm -f /etc/calamares/modules/shellprocess-tridentity.conf

cat > /etc/calamares/modules/welcome.conf <<'WELCOME'
---
showSupportUrl: true
showKnownIssuesUrl: true
showReleaseNotesUrl: true
requirements:
  # The installed desktop needs substantially less than this. Keep enough
  # headroom for updates without rejecting common 16 GB test VMs.
  requiredStorage: 12.0
  requiredRam: 2.0
  check:
    - storage
    - ram
WELCOME

# Accept any user-entered password, including simple numeric passwords. The
# weak-password option is visible and enabled by default as a second safeguard
# for Calamares builds compiled with libpwquality support.
cat > /etc/calamares/modules/users.conf <<'USERS'
---
defaultGroups:
  - cdrom
  - floppy
  - sudo
  - audio
  - dip
  - video
  - plugdev
  - netdev
  - lpadmin
  - scanner
  - bluetooth
autologinGroup: autologin
sudoersGroup: sudo
sudoersConfigureWithGroup: false
setRootPassword: false
displayAutologin: true
doAutologin: false

passwordRequirements:
  minLength: -1
  maxLength: -1
  libpwquality:
    - minlen=0
    - minclass=0
allowWeakPasswords: true
allowWeakPasswordsDefault: true

user:
  shell: /bin/bash
  forbidden_names: [ root, nobody ]
  home_permissions: "o700"

hostname:
  location: EtcFile
  writeHostsFile: true
  template: "${first}-tr-linux"
  forbidden_names: [ localhost ]
USERS
