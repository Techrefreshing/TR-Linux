#!/bin/sh
# Copyright © 2026 TechRefreshing
# SPDX-License-Identifier: GPL-3.0-only
set -eu

# Remove Debian's live-installer launchers. We keep Debian's tested Calamares
# module configuration underneath, but expose only the TR Linux entry point.
rm -f /usr/share/applications/install-debian.desktop
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /usr/share/pixmaps/install-debian.png

# Use Debian's proven live-media elevation pattern, branded for TR Linux.
cat > /usr/local/bin/calamares-install-tr-linux <<'WRAPPER'
#!/bin/sh
set -u
moved_fstab=0
cleanup() {
    xhost -si:localuser:root >/dev/null 2>&1 || true
    if [ "$moved_fstab" -eq 1 ] && [ -e /etc/fstab.orig.calamares ]; then
        sudo mv /etc/fstab.orig.calamares /etc/fstab || true
    fi
}
trap cleanup EXIT INT TERM

if [ -e /etc/fstab ] && [ ! -e /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab /etc/fstab.orig.calamares
    moved_fstab=1
fi

export QT_AUTO_SCREEN_SCALE_FACTOR=1
xhost +si:localuser:root >/dev/null 2>&1 || true
pkexec calamares
exit $?
WRAPPER
chmod 0755 /usr/local/bin/calamares-install-tr-linux

# The live account is intentionally passwordless for installer elevation. The
# rule is harmless on the installed system because the live user is not copied
# by Calamares.
install -d -m 0750 /etc/sudoers.d
cat > /etc/sudoers.d/tr-linux-live-installer <<'SUDOERS'
trlinux ALL=(root) NOPASSWD: /usr/bin/calamares
SUDOERS
chmod 0440 /etc/sudoers.d/tr-linux-live-installer

cat > /usr/share/applications/install-tr-linux.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Install TechRefreshing Linux
GenericName=System Installer
Comment=Install TechRefreshing Linux on this computer
Exec=/usr/local/bin/calamares-install-tr-linux
Icon=tr-linux-installer
Terminal=false
Categories=System;
Keywords=installer;calamares;system;
DESKTOP

install -d /usr/share/icons/hicolor/512x512/apps
cp /usr/share/tr-linux/branding/install-tr-linux.png /usr/share/icons/hicolor/512x512/apps/tr-linux-installer.png

# The first-session setup and welcome application are installed from
# config/includes.chroot so they can be tested independently of this hook.
chmod 0755 /usr/local/bin/tr-linux-session-setup /usr/local/bin/tr-linux-welcome /usr/local/bin/tr-linux-welcome-first-run

# Debian's default wallpaper is visible before Plasma autostart. Replace the
# desktop-base theme raster images at image-build time so the first rendered
# frame already uses TechRefreshing artwork.
find /usr/share/desktop-base -path '*/wallpaper/contents/images/*' -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' \) -exec ln -sf /usr/share/tr-linux/branding/wallpaper-3840x2160.png {} \; 2>/dev/null || true
find /usr/share/desktop-base -path '*/wallpaper/contents/images/*' -type f -name '*.svg' -exec ln -sf /usr/share/tr-linux/branding/wallpaper.svg {} \; 2>/dev/null || true

if [ -e /usr/share/images/desktop-base/desktop-background ]; then
    rm -f /usr/share/images/desktop-base/desktop-background
    ln -s /usr/share/tr-linux/branding/wallpaper-3840x2160.png /usr/share/images/desktop-base/desktop-background
fi

# Custom SDDM theme: retain the stable Breeze QML implementation, but replace
# its visual identity with TechRefreshing branding.
if [ -d /usr/share/sddm/themes/breeze ]; then
    rm -rf /usr/share/sddm/themes/tr-linux
    cp -a /usr/share/sddm/themes/breeze /usr/share/sddm/themes/tr-linux
    cat > /usr/share/sddm/themes/tr-linux/theme.conf.user <<'THEME'
[General]
background=/usr/share/tr-linux/branding/sddm-background.png
type=image
THEME
fi

install -d /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-tr-linux.conf <<'SDDM'
[Autologin]
User=trlinux
Session=plasma
Relogin=true

[Theme]
Current=tr-linux
SDDM

install -d /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-tr-linux.conf <<'NM'
[main]
plugins=ifupdown,keyfile

[ifupdown]
managed=true
NM

systemctl enable NetworkManager.service || true
systemctl enable sddm.service || true
systemctl enable fwupd.service || true
systemctl enable tr-linux-first-boot.service || true

# TR Linux provides its own first-run centre. Suppress KDE's separate Welcome
# Centre without removing shared Plasma libraries.
rm -f /etc/xdg/autostart/org.kde.plasma-welcome.desktop
rm -f /usr/share/applications/org.kde.plasma-welcome.desktop
rm -f /usr/share/applications/plasma-welcome.desktop

# KDE and other desktop components request these standard distributor icon
# names. Point only the system-branding aliases to TR artwork; Debian package
# metadata and the required Debian attribution remain untouched.
for size in 64 128 256 512; do
    icon_dir="/usr/share/icons/hicolor/${size}x${size}/apps"
    install -d "$icon_dir"
    cp /usr/share/tr-linux/branding/tr-monogram.png "$icon_dir/tr-linux.png"
    ln -sf tr-linux.png "$icon_dir/distributor-logo.png"
    ln -sf tr-linux.png "$icon_dir/system-logo.png"
    ln -sf tr-linux.png "$icon_dir/start-here.png"
done

gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true

# Brand the live account immediately. The installed account is handled by the
# Calamares target finalizer once its chosen username exists.
install -d /var/lib/AccountsService/icons /var/lib/AccountsService/users
cp /usr/share/tr-linux/branding/tr-monogram.png /var/lib/AccountsService/icons/trlinux
cat > /var/lib/AccountsService/users/trlinux <<'ACCOUNT'
[User]
Icon=/var/lib/AccountsService/icons/trlinux
SystemAccount=false
ACCOUNT
chmod 0644 /var/lib/AccountsService/icons/trlinux
chmod 0600 /var/lib/AccountsService/users/trlinux
