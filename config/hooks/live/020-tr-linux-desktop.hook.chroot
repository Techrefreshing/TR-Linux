#!/bin/sh
set -eu

install -d /etc/skel/Desktop
cat > /etc/skel/Desktop/install-tr-linux.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install TR Linux
Comment=Install TR Linux on this computer
Exec=calamares
Icon=calamares
Terminal=false
Categories=System;
EOF
chmod 0755 /etc/skel/Desktop/install-tr-linux.desktop

install -d /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-tr-linux.conf <<'EOF'
[Autologin]
User=live
Session=plasma
Relogin=true

[Theme]
Current=breeze
EOF

install -d /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-tr-linux.conf <<'EOF'
[main]
plugins=ifupdown,keyfile

[ifupdown]
managed=true
EOF

systemctl enable NetworkManager.service || true
systemctl enable sddm.service || true
systemctl enable fwupd.service || true
