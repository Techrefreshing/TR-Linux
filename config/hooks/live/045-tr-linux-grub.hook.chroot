#!/bin/sh
# Copyright © 2026 TechRefreshing
# SPDX-License-Identifier: GPL-3.0-only
set -eu

THEME=/boot/grub/themes/tr-linux
install -d "$THEME" /etc/default/grub.d
cp /usr/share/tr-linux/branding/grub-background.png "$THEME/background.png"

cat > "$THEME/theme.txt" <<'THEME'
# TechRefreshing Linux installed GRUB theme
title-text: ""
desktop-image: "background.png"
desktop-color: "#071226"
message-color: "#f5f7fa"
message-bg-color: "#0e1b2b"
terminal-font: "DejaVu Sans Mono 14"

+ boot_menu {
    left = 18%
    top = 28%
    width = 64%
    height = 48%
    item_font = "DejaVu Sans Regular 16"
    item_color = "#d8e8f7"
    selected_item_color = "#42a5f5"
    item_height = 40
    item_padding = 14
    item_spacing = 8
}

+ label {
    left = 0
    top = 88%
    width = 100%
    align = "center"
    text = "Familiar. Beautiful. Stable."
    font = "DejaVu Sans Regular 14"
    color = "#42a5f5"
}
THEME

cat > /etc/default/grub.d/99-tr-linux.cfg <<'GRUBCFG'
GRUB_DISTRIBUTOR="TechRefreshing Linux"
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=3
GRUB_RECORDFAIL_TIMEOUT=3
GRUB_DISABLE_OS_PROBER=false
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME="/boot/grub/themes/tr-linux/theme.txt"
GRUB_BACKGROUND="/boot/grub/themes/tr-linux/background.png"
GRUBCFG
