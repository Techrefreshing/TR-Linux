#!/bin/sh
# Copyright © 2026 TechRefreshing
# SPDX-License-Identifier: GPL-3.0-only
set -eu

THEME=/usr/share/plymouth/themes/tr-linux
install -d "$THEME"
cp /usr/share/tr-linux/branding/plymouth-logo.png "$THEME/plymouth-logo.png"
cp /usr/share/tr-linux/branding/plymouth-star.png "$THEME/plymouth-star.png"
cp /usr/share/tr-linux/branding/plymouth-dot.png "$THEME/plymouth-dot.png"

cat > "$THEME/tr-linux.plymouth" <<'PLYMOUTH'
[Plymouth Theme]
Name=TechRefreshing Linux
Description=TechRefreshing Linux boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/tr-linux
ScriptFile=/usr/share/plymouth/themes/tr-linux/tr-linux.script
PLYMOUTH

cat > "$THEME/tr-linux.script" <<'SCRIPT'
Window.SetBackgroundTopColor(0.004, 0.015, 0.035);
Window.SetBackgroundBottomColor(0.020, 0.070, 0.140);
logo.image = Image("plymouth-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

dot.image = Image("plymouth-dot.png");
for (i = 0; i < 4; i++) {
    dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetX(Window.GetWidth() / 2 - 55 + (i * 36));
    dots[i].sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 14);
}

frame = 0;
active = 0;
step = 0;
fun refresh_callback () {
    frame++;
    step++;
    if (step >= 8) {
        step = 0;
        active++;
        if (active >= 4) active = 0;
    }
    for (i = 0; i < 4; i++) {
        if (i == active) dots[i].sprite.SetOpacity(1);
        else dots[i].sprite.SetOpacity(0.28);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

prompt.sprite = Sprite();
prompt.sprite.SetZ(10000);
fun display_password_callback (text, bullets) {
    prompt.image = Image.Text(text + "  " + bullets, 1, 1, 1);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(Window.GetWidth() / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(Window.GetHeight() * 0.72);
}
fun display_normal_callback () {
    prompt.sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
SCRIPT

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme tr-linux || true
fi
update-initramfs -u -k all || true
